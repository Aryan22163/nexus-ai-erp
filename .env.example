# ==============================================================================
# NEXUS AI - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Configuration
APP_NAME="NEXUS AI"
APP_ENV="development" # development | staging | production
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="nexus_admin"
POSTGRES_PASSWORD="nexus_secure_password"
POSTGRES_DB="nexus_db"
DATABASE_URL="postgresql+asyncpg://nexus_admin:nexus_secure_password@localhost:5432/nexus_db"

# Redis & Background Tasks
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Authentication & Security
JWT_SECRET="replace-with-jwt-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers
DEFAULT_LLM_PROVIDER="openai" # openai | anthropic | local
OPENAI_API_KEY="sk-placeholder-key-for-openai"
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

ANTHROPIC_API_KEY="placeholder-key-for-anthropic"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3.1"

# Document Storage
STORAGE_BACKEND="local" # local | s3
STORAGE_LOCAL_PATH="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="nexus-ai-documents"

# Logging & Monitoring
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR
ENABLE_AUDIT_LOGGING=True
